.DS_Store
.pytest_cache/
**/__pycache__/
*.py[cod]
*.egg-info/

# Local environment
.venv-pipeline/

# Raw data, fitted models and row-level outputs stay local; preserve them with
# checksums and approved restricted archival rather than deleting them.
data/raw/
outputs/

# Only the reviewed aggregate publication package is version-controlled.
# Additional results require a privacy/provenance review before explicit add.
results/*
!results/final_publication/

# Local/editor and coverage artifacts
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.idea/
.vscode/
.venv/
venv/
.env
.env.*
!.env.example
*.pem
*.key
build/
dist/
*.tmp
*.swp
outputs/.matplotlib/

# Office lock/temporary files
~$*.docx
